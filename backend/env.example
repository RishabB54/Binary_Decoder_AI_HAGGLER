# Gemini 2.5 Flash API Keys - Team: binarydecoders
# Copy this file to .env and fill in your actual keys

# Text Model (for chat and intent extraction)
GEMINI_TEXT_API_KEY=your_text_api_key_here

# Image Model (for image analysis - optional)
GEMINI_IMAGE_API_KEY=your_image_api_key_here

# Server Configuration
PORT=8080
NODE_ENV=development

# Dexter RAG Configuration (Optional - for enhanced product search)
# Get credentials from mlp-oncall@flipkart.com or raise Jira ticket
# See DEXTER_SETUP.md for detailed instructions
DEXTER_CLIENT_ID=your_dexter_client_id_here
DEXTER_CLIENT_SECRET=your_dexter_client_secret_here
DEXTER_TENANT_ID=your_dexter_tenant_id_uuid
DEXTER_COLLECTION_ID=your_dexter_collection_id_uuid
